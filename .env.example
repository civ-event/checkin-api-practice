# ===== 应用基础 =====
APP_NAME=checkin-api-practice          # 服务名（健康检查会读）
APP_ENV=local                          # 环境标识：local/dev/prod
APP_DEBUG=1                            # 1=暴露错误细节；生产请改 0
APP_URL=http://localhost:18080         # 对外访问地址（文档/脚本参考）
APP_TIMEZONE=Asia/Shanghai             # 业务时区（判断「今天」）

# ===== HTTP / CORS =====
HTTP_PORT=18080                        # 映射到宿主机的 Nginx 端口
CORS_ORIGINS=http://localhost:5173,http://localhost:18080  # 允许的浏览器 Origin，逗号分隔

# ===== MySQL（容器内主机名是服务名 mysql）=====
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=checkin
MYSQL_USER=checkin
MYSQL_PASSWORD=checkin                 # 学习占位；真实环境用密钥管理，勿提交真密码
MYSQL_ROOT_PASSWORD=root

# ===== Memcached（分布式锁；只在内存）=====
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211

JWT_SECRET=change-me
JWT_TTL=3600