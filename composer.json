{
  "name": "local/checkin-api-practice",
  "description": "Daily check-in API learning project",
  "type": "project",
  "require": {
    "php": ">=8.5",
    "doctrine/dbal": "^4.2",
    "doctrine/orm": "^3.6",
    "firebase/php-jwt": "^7.2",
    "oasis/core-sdk": "^3.2",
    "oasis/doctrine-addon": "^3.1",
    "oasis/slimapp": "^3.2",
    "symfony/cache": "^7.2",
    "symfony/event-dispatcher": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "Checkin\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "repositories": {
    "oasis": {
      "type": "composer",
      "url": "https://private-composer.oasgames.com"
    }
  }
}
